# Relay — copy to .env
POSTGRES_USER=relay
POSTGRES_PASSWORD=relay
POSTGRES_DB=relay
DATABASE_URL=postgresql+psycopg://relay:relay@postgres:5432/relay

REDIS_URL=redis://redis:6379/0

SECRET_KEY=change-me-in-production-use-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

ADMIN_EMAIL=admin@relay.local
ADMIN_PASSWORD=RelayDemo2026!
ADMIN_NAME=Relay Admin

CORS_ORIGINS=http://localhost:3000,http://localhost:3001
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# Optional connectors (demo works with none of these)
SLACK_WEBHOOK_URL=
HUBSPOT_ACCESS_TOKEN=

# Worker
WORKER_ID=worker-1
LEASE_SECONDS=30
HEARTBEAT_SECONDS=10
POLL_INTERVAL_SECONDS=1
